<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/main.css">
    <% if (NODE_ENV.includes('dev')) { %>
      <script>
        // Get the current hostname and port from the browser
        const host = window.location.hostname;
        const currentPort = window.location.port;

        // Calculate WebSocket port (current port + 1)
        const wsPort = currentPort ? (parseInt(currentPort) + 1) : 3001;

        // Create WebSocket connection using dynamic hostname and port
        const ws = new WebSocket(`ws://${host}:${wsPort}`);
        ws.onclose = () => {
          setTimeout(() => location.reload(), 2000);
        };
      </script>
    <% } %>
</head>
<body>
  <header class="site-header">
    <div class="header-container">

      <a href="/" class="site-logo">
        <span class="logo-icon">✦</span>
        <div class="logo-text">
          <span class="logo-title">THE MIDNIGHT</span>
          <span class="logo-subtitle">DETECTIVE AGENCY</span>
        </div>
      </a>

      <nav class="main-nav" aria-label="Main navigation">
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/cases">Case Files</a></li>
          <li><a href="/investigations">My Investigations</a></li>
        </ul>
      </nav>

      <div class="header-actions">
        <a href="/login" class="btn btn-outline">Log In</a>
        <a href="/register" class="btn btn-gold">Join Agency</a>
      </div>

    </div>
  </header>